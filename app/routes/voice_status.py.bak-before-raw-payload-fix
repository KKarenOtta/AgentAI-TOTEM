from __future__ import annotations

from typing import Any

from fastapi import APIRouter
from pydantic import BaseModel, Field

from infra.realtime.event_bus import publish

router = APIRouter(prefix="/api/voice", tags=["voice"])


class VoiceStatusRequest(BaseModel):
    company_id: str = Field(..., min_length=1)
    device_id: str | None = None
    session_id: str | None = None
    status: str = Field(..., min_length=1)

    text: str | None = None
    message: str | None = None
    transcription: str | None = None
    response: str | None = None

    audio_base64: str | None = None
    audio_path: str | None = None

    rms: int | float | None = None
    payload: dict[str, Any] | None = None


@router.post("/status")
def voice_status(req: VoiceStatusRequest) -> dict[str, bool]:
    payload: dict[str, Any] = {
        "company_id": req.company_id,
        "device_id": req.device_id,
        "session_id": req.session_id,
        "status": req.status,
        "text": req.text or req.message or req.response or req.transcription,
        "message": req.message,
        "transcription": req.transcription,
        "response": req.response,
        "audio_base64": req.audio_base64,
        "audio_path": req.audio_path,
        "rms": req.rms,
    }

    if req.payload:
        payload["payload"] = req.payload

        for key, value in req.payload.items():
            if key not in payload or payload[key] is None:
                payload[key] = value

    publish(
        company_id=req.company_id,
        event="voice_status",
        payload=payload,
    )

    return {"ok": True}

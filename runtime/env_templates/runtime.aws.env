# ============================================================
# TOTEM IA.GORA - RUNTIME AWS + RASPBERRY EDGE
# Arquivo de referência para manter IPs e endpoints em um só lugar.
# Não colocar segredos reais neste arquivo.
# Copiar para .env em cada ambiente quando necessário.
# ============================================================

# ---- AMBIENTE PRINCIPAL ----
ENVIRONMENT=aws
COMPANY_ID=FLX-001

# ---- BACKEND / URLs ----
AWS_HOST=52.201.76.45
BACKEND_PORT=8000
TOTEM_PUBLIC_BASE_URL=http://52.201.76.45:8000
TOTEM_API_BASE_URL=http://52.201.76.45:8000
TOTEM_API_URL=http://52.201.76.45:8000/api/presence/trigger

# ---- DEVICE EDGE / RASPBERRY ----
DEVICE_ID=RPI3-SENSORS-001

# ---- PRESENÇA / SENSOR ----
PRESENCE_HOLD_SECONDS=3
ABSENCE_TIMEOUT_SECONDS=5
PRESENCE_REQUIRE_IMAGE=true
PRESENCE_REQUIRE_HUMAN_VALIDATION=true
CAPTURE_ENABLED=true
CAPTURE_PATH=/tmp/totem_presence.jpg

# ---- ÁUDIO EDGE / RASPBERRY ----
AUDIO_CAPTURE_DEVICE=plughw:3,0
AUDIO_PLAYBACK_DEVICE=plughw:0,0
VOICE_AUDIO_DEVICE=plughw:3,0
VOICE_RECORD_SECONDS=6
VOICE_MIN_RMS=80
VOICE_REQUEST_TIMEOUT_SECONDS=90

# ---- TTS BACKEND ----
TTS_PROVIDER=elevenlabs
TTS_ALLOW_FALLBACK=true
TTS_FORMAT=mp3
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_API_KEY=preencher_no_env_real
# ELEVENLABS_VOICE_ID=preencher_no_env_real
# OPENAI_API_KEY=preencher_no_env_real

# ---- STT BACKEND ----
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ---- REDIS / WORKERS ----
REDIS_URL=redis://localhost:6379/0

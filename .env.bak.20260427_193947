# APP - CONFIGURAÇÃO GERAL
APP_NAME=AgentAI-TOTEM
APP_ENV=production            # development | staging | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=9000


# IDENTIDADE / MULTI-TENANT
DEFAULT_COMPANY_ID=FLX-001

# PRESENÇA (TOTEM / SENSOR)
PRESENCE_TIMEOUT_S=15         # tempo sem heartbeat para encerrar sessão
PRESENCE_COOLDOWN_S=5         # tempo mínimo entre triggers

# LLM PROVIDERS (USE PELO MENOS UM)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ordem de fallback (opcional)
LLM_PRIORITY=openai,gemini,openrouter

# HUGGING FACE (TTS / MODELOS AUXILIARES)
HUGGING_FACE=

# TTS (TEXT TO SPEECH)
TTS_PROVIDER=local           # local | huggingface | external
TTS_ENABLED=true
TTS_LANGUAGE=pt-BR
TTS_FALLBACK_FILE=data/metrics/voz_fallback.mp3

# STT (SPEECH TO TEXT)
STT_PROVIDER=browser         # browser | whisper | external
STT_ENABLED=true

# TRADUÇÃO
TRANSLATION_ENABLED=true
DEFAULT_LANGUAGE=pt-BR

# RECOMMENDER
RECOMMENDER_TOP_K=3

# CAMPANHAS
CAMPAIGNS_DB_PATH=data/campaigns.json
CAMPAIGNS_UPLOAD_DIR=static/uploads/campaigns
QRCODE_OUTPUT_DIR=static/uploads/qrcodes

# MÉTRICAS
METRICS_PATH=data/metrics/metrics.jsonl
METRICS_REPORT_PATH=data/metrics/metrics_report.md

# NPS
NPS_PATH=data/nps/nps.jsonl

# REALTIME / SSE
EVENT_BUS_ENABLED=true
EVENT_BUS_BUFFER_SIZE=100

# EDGE (RASPBERRY PI - SENSOR REMOTO)
TOTEM_API_URL=https://SEU-DOMINIO.com/api   #EM PRODUÇÃO

COMPANY_ID=FLX-001
DEVICE_ID=RPI3-PIR-001

PIR_PIN=17
POLL_INTERVAL_S=0.20
CLEAR_DELAY_S=4

# DEBUG
DEBUG=false
ENABLE_SWAGGER=true
